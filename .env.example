# Copy to .env and fill in. Never commit .env (it is gitignored).
BOT_TOKEN=
LOG_LEVEL=INFO

# UI language (gettext catalog bot/locales/<locale>/LC_MESSAGES/messages.*;
# a locale without a catalog falls back to English)
LOCALE=en

# Your Telegram user id: bootstrap right to /settings in the bot's DM
# (needed before the first pair exists)
OWNER_ID=

# Async SQLAlchemy URL. The scheme must name an async driver.
# Uncomment one line, fill in the credentials, and leave the others commented.
# Never commit real credentials (.env is gitignored).
#
# PostgreSQL — asyncpg ships with the project:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tg_threader
#
# MySQL and MariaDB — pip install aiomysql (not a project dependency):
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/tg_threader
#
# SQLite file — pip install aiosqlite, or pip install -e ".[dev]":
# DATABASE_URL=sqlite+aiosqlite:///bot.db
