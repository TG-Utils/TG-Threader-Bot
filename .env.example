# Copy to .env and fill in. Never commit .env (it is gitignored).
BOT_TOKEN=
LOG_LEVEL=INFO

# UI language pack (file in bot/locales/<locale>.json)
LOCALE=en

# Your Telegram user id: bootstrap right to /settings in the bot's DM
# (needed before the first pair exists)
OWNER_ID=

# Async SQLAlchemy URL (dev/local postgres; never commit real credentials)
DATABASE_URL=
